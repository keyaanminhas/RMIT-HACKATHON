# Copy to .env. Keep .env private and choose a unique admin password.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Set these only after the licence owner provides their email and accepts
# Tide's Terms & Conditions: https://tide.org/legal
TIDE_LICENSE_EMAIL=
TIDE_TERMS_ACCEPTED=

# NeutralVault browser origin; the new Next.js app will use this port.
NEUTRALVAULT_APP_URL=http://localhost:3000
TIDE_PROJECT_NAME=RMITHACKATHON
TIDE_REALM_NAME=rmithackathon
TIDE_CLIENT_ID=rmithackathon-client
TIDE_OWNER_USERNAME=admin
